# ============================================================
# Root .gitignore — covers both client/ and server/
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Environment variable files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local

# Vite / React build output
client/dist/
client/.vite/

# macOS metadata
.DS_Store
**/.DS_Store

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
coverage/

# Temporary files
*.tmp
*.temp

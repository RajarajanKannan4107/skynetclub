# =============================================================================
# SKYNET BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your Supabase project credentials
# =============================================================================

# Server Port & Environment
PORT=5001
NODE_ENV=development

# Allowed Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Supabase API Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY bypasses RLS and MUST NEVER be exposed to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Buckets
STORAGE_BUCKET_SUBMISSIONS=task-submissions
STORAGE_BUCKET_PROJECTS=project-thumbnails

# Max Upload Size (in Megabytes)
MAX_FILE_SIZE_MB=15
